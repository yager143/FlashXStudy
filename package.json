{
  "name": "flashxstudy",
  "private": true,
  "version": "1.0.0",
  "description": "FlashXStudy — The open-source, local-first flashcard study app",
  "author": "FlashXStudy Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:pack:mac": "npm run build && npx electron-builder --mac",
    "electron:pack:win": "npm run build && npx electron-builder --win",
    "pack:mac": "npm run build && electron-builder --mac --dmg"
  },
  "build": {
    "appId": "com.openquiz.studyapp",
    "productName": "FlashXStudy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fontsource/alef": "^5.3.0",
    "@types/react-router-dom": "^5.3.3",
    "dexie": "^4.4.6",
    "framer-motion": "^14.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
